{
  "name": "shaken",
  "version": "0.1.0",
  "description": "車検 Roadworthy inspections for AI agents: golden cases, cheap checks first, an LLM judge last, pass rates over repeated runs, and a failed build when your agent drifts.",
  "type": "module",
  "bin": {
    "shaken": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "bundle": "node scripts/bundle.mjs"
  },
  "keywords": [
    "llm",
    "agents",
    "evals",
    "eval",
    "testing",
    "ci",
    "github-action",
    "llm-judge",
    "regression"
  ],
  "author": "Elyra Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuasiInteractive/shaken.git"
  },
  "homepage": "https://github.com/QuasiInteractive/shaken#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
